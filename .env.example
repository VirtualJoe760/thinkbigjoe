# Postgres connection string (Neon).
# On Vercel this is injected automatically by the Neon integration as DATABASE_URL.
# For local dev, run: vercel env pull .env.development.local
# (or paste a pooled Neon connection string here).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Long random string used to sign/encrypt Payload auth tokens.
# Generate one with: openssl rand -base64 48
PAYLOAD_SECRET=replace-with-a-long-random-secret
