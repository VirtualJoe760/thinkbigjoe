# Postgres connection string (Neon).
# On Vercel this is injected automatically by the Neon integration as DATABASE_URL.
# For local dev, run: vercel env pull .env.development.local
# (or paste a pooled Neon connection string here).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Long random string used to sign/encrypt Payload auth tokens.
# Generate one with: openssl rand -base64 48
PAYLOAD_SECRET=replace-with-a-long-random-secret

# --- Client portal auth (better-auth) ---
# Secret for signing portal sessions. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Public base URL of the app (used for OAuth callbacks).
# Local: http://localhost:3000 — Production: https://your-domain
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console → Credentials → OAuth client ID).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth (Meta for Developers → app → Facebook Login).
# Valid OAuth redirect URI: <BETTER_AUTH_URL>/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Booking / Google Calendar (strategy-call flow at /book-appointment) ---
# Books onto Joe's Google Calendar — the SAME calendar jpsrealtor uses, so
# availability is shared. The refresh token is bound to jpsrealtor's OAuth
# client, hence the separate GCAL_* client pair here.
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=
GCAL_REFRESH_TOKEN=
GCAL_CALENDAR_ID=primary

# --- Bot protection (Cloudflare Turnstile) ---
# Free: Cloudflare dashboard → Turnstile → add a widget (domain: thinkbigjoe.com
# + localhost for dev). Guards email signup/sign-in against bots.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Site ---
# Public base URL — used for SEO, sitemap/robots, OG images, and email links.
NEXT_PUBLIC_SITE_URL=https://thinkbigjoe.com

# --- Email (Nodemailer / SMTP) ---
# Any SMTP provider works. Gmail example: host smtp.gmail.com, port 587,
# user = your gmail, pass = a Google "App Password" (needs 2-Step Verification).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: "true" for port 465 (implicit TLS), "false" for 587 (STARTTLS).
# SMTP_SECURE=false
# From address for all transactional emails.
EMAIL_FROM="ThinkBigJoe <no-reply@thinkbigjoe.com>"
# Forward a copy of every transactional email here (admin visibility). Optional.
EMAIL_BCC=you@example.com

# --- Stripe ---
# Test-mode keys from the Stripe dashboard (Developers → API keys).
STRIPE_SECRET_KEY=
# Webhook signing secret (Developers → Webhooks → your endpoint).
STRIPE_WEBHOOK_SECRET=
# Only needed if/when client-side Stripe.js checkout is added:
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Twilio SMS (A2P 10DLC) ---------------------------------------------------
# Sends through the shared, A2P-registered "jsardella" LLC brand + verified
# "Low Volume Mixed" campaign (the same one chatRealty uses — allowed because
# both are one legal entity). See docs/SMS.md.
# Console → Account → API keys & tokens.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
# The Messaging Service the campaign owns (Console → Messaging → Services).
TWILIO_MESSAGING_SERVICE_SID=MG...
# Inbound texts are forwarded here (Joe's Google Voice), E.164.
SMS_FORWARD_TO=+17602976966
# Inbound CALLS to the Twilio number ring through to this line (the Retell AI
# receptionist "Ivy"). Defaults to +14807642121 if unset.
VOICE_FORWARD_TO=+14807642121
# When a caller gives Ivy a valid PRIORITY CALLBACK CODE, she transfers them to
# this number (Joe's line). Defaults to the Google Voice number if unset.
CALLBACK_TRANSFER_TO=+17602976966

# ── Drop Cowboy: ringless voicemail (see docs/VOICEMAIL.md) ──
# Drops a pre-recorded voicemail into a lead's inbox (no ring), then a follow-up
# text. No-op until TEAM_ID + SECRET + BRAND_ID + RECORDING_ID are all set.
# Settings → API for team id + secret; Trust Center for the brand GUID.
DROPCOWBOY_TEAM_ID=
DROPCOWBOY_SECRET=
DROPCOWBOY_BRAND_ID=
# The voicemail Joe recorded once in the dashboard (Recordings tab).
DROPCOWBOY_RECORDING_ID=
# Callbacks route here — set to the TBJ number so they reach Ivy.
DROPCOWBOY_FORWARDING_NUMBER=+17602620014
# Optional: private caller-id number pool; token for the delivery webhook.
DROPCOWBOY_POOL_ID=
DROPCOWBOY_WEBHOOK_SECRET=
