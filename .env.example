# Postgres connection string (Neon).
# Neon dashboard → your project → Connection string (use the "pooled" URI).
DATABASE_URI=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Long random string used to sign/encrypt Payload auth tokens.
# Generate one with: openssl rand -base64 48
PAYLOAD_SECRET=replace-with-a-long-random-secret
