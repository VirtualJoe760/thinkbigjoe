  },
  "dependencies": {
    "@browserbasehq/sdk": "^2.0.0",
    "@neondatabase/serverless": "^0.10.0",
    "playwright-core": "^1.49.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
