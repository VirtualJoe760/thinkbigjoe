{
  "name": "thinkbigjoe-linkedin-sender",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Cloud LinkedIn drip-sender + reply-poster (Browserbase + Playwright). Supersedes windows-sender.",
  "scripts": {
    "seed": "node seed-auth.mjs",
    "send": "node run-sender.mjs",
    "replies": "node run-replies.mjs",
