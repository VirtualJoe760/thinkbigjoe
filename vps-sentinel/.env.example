# Reply Sentinel config — copy to .env and fill in (never commit the real .env)
GMAIL_USER="josephsardella@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"   # Gmail App Password, not your real password
TELEGRAM_BOT_TOKEN="<same token as your site's TELEGRAM_BOT_TOKEN>"
TELEGRAM_CHAT_ID="<your chat id, e.g. 6338621557>"
# A Gmail filter routes all linkedin.com mail to the "LinkedIn" label (skip inbox),
# so the Sentinel must watch that label, NOT the inbox:
MAILBOX="LinkedIn"
# Optional:
# POLL_MS="60000"
