# Flatten node_modules (npm-style) so Next.js / Vercel file tracing can
# resolve sharp's native libvips binaries (@img/sharp-libvips-linux-x64).
# Without this, pnpm's symlinked store isn't fully traced into the serverless
# function and sharp fails at runtime with ERR_DLOPEN_FAILED (libvips-cpp.so).
node-linker=hoisted
